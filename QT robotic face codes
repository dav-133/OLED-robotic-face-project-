
// Declare Button before Arduino's automatic function-prototype generation.
// This prevents the IDE from generating buttonPressed(Button&) before Button exists.
struct Button {
  int pin;
  bool stable;
  bool reading;
  unsigned long changedAt;
  unsigned long pressedAt;
  bool longHandled;
  bool longEvent;
};

#include <Arduino.h>
#include <Wire.h>
#include <U8g2lib.h>
#include <WiFi.h>
#include <time.h>

// SH1106 128x64 OLED, I2C
// If your OLED is SSD1306, change this constructor.
U8G2_SH1106_128X64_NONAME_F_HW_I2C oled(
  U8G2_R0, U8X8_PIN_NONE
);

// Existing wiring
const int TOUCH_PIN  = 32;
const int BTN_DOWN   = 18;
const int BTN_SELECT = 19;
const int LED1       = 23;
const int LED2       = 16;
const int BUZZER     = 25;

// Nairobi, Kenya: East Africa Time (UTC+3), no daylight-saving time.
// Replace these placeholders with your Wi-Fi network details.
const char* WIFI_SSID = "Q-DEVELOPER";
const char* WIFI_PASSWORD = "Fauna@2026";

const char* NTP_SERVER_1 = "pool.ntp.org";
const char* NTP_SERVER_2 = "time.google.com";

unsigned long lastWiFiAttempt = 0;
bool ntpConfigured = false;

void maintainWiFiTime() {
  unsigned long now = millis();

  if (WiFi.status() == WL_CONNECTED) {
    if (!ntpConfigured) {
      configTzTime("EAT-3", NTP_SERVER_1, NTP_SERVER_2);
      ntpConfigured = true;
      Serial.println("Wi-Fi connected. Synchronising Nairobi time...");
    }
    return;
  }

  // Retry every 30 seconds without blocking the robot interface.
  if (now - lastWiFiAttempt >= 30000UL) {
    lastWiFiAttempt = now;

    // Avoid trying to connect if the placeholder credentials are unchanged.
    if (String(WIFI_SSID) == "YOUR_WIFI_NAME") {
      return;
    }

    Serial.println("Connecting to Wi-Fi...");
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  }
}

bool readLocalTime(struct tm &timeInfo) {
  time_t now = time(nullptr);
  if (now < 1700000000) return false;  // Clock has not been synchronised yet.
  localtime_r(&now, &timeInfo);
  return true;
}

void drawClockHeader() {
  struct tm timeInfo;
  char dateText[12];
  char timeText[12];

  oled.setFont(u8g2_font_5x7_tf);

  if (readLocalTime(timeInfo)) {
    strftime(dateText, sizeof(dateText), "%d/%m/%y", &timeInfo);
    strftime(timeText, sizeof(timeText), "%H:%M:%S", &timeInfo);
  } else {
    snprintf(dateText, sizeof(dateText), "--/--/--");
    snprintf(timeText, sizeof(timeText), "--:--:--");
  }

  oled.drawStr(1, 8, dateText);
  oled.drawStr(87, 8, timeText);
}


